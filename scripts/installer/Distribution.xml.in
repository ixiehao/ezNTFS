<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
  <title>ezNTFS</title>
  <options customize="never" require-scripts="true" hostArchitectures="@ARCHITECTURE@"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <welcome file="Welcome.html" mime-type="text/html"/>
  <installation-check script="checkArchitecture() &amp;&amp; checkMacFUSE() &amp;&amp; checkDriverUsage()"/>
  <volume-check>
    <allowed-os-versions>
      <os-version min="@MINIMUM_OS@"/>
    </allowed-os-versions>
  </volume-check>
  <script><![CDATA[
function isExternal(entry) {
    var connection = entry["Protocol Characteristics"] || {};
    if (connection["Physical Interconnect Location"] === "External") {
        return true;
    }
    var parents = system.ioregistry.parentsOf(entry) || [];
    return Array.prototype.some.call(parents, isExternal);
}

function installationError(title, message) {
    my.result.type = "Fatal";
    my.result.title = title;
    my.result.message = message;
    system.log("ezNTFS: " + message);
    return false;
}

function checkArchitecture() {
    var architecture = Number(system.sysctl("hw.optional.arm64")) === 1 ? "arm64" : "x86_64";
    if (architecture === "@ARCHITECTURE@") {
        return true;
    }
    return installationError(system.localizedString("architecture.title"),
        system.localizedString("architecture.message").replace("{architecture}", architecture));
}

function checkMacFUSE() {
    var path = "/Library/Filesystems/macfuse.fs";
    var required = "@MACFUSE_VERSION@";
    if (!system.files.fileExistsAtPath(path)) {
        var download = "https://github.com/macfuse/macfuse/releases/tag/macfuse-" + required;
        return installationError(system.localizedString("macFUSE.missingTitle"),
            system.localizedString("macFUSE.missingMessage")
                .replace("{required}", required).replace("{download}", download));
    }

    var info;
    try {
        info = system.files.plistAtPath(path + "/Contents/Info.plist");
    } catch (error) {
        system.log("ezNTFS: Cannot read the macFUSE bundle information.");
    }
    var installed = info && info["CFBundleShortVersionString"];
    if (typeof installed !== "string" || !installed) {
        return installationError(system.localizedString("macFUSE.incompleteTitle"),
            system.localizedString("macFUSE.incompleteMessage").replace("{required}", required));
    }
    if (installed !== required) {
        return installationError(system.localizedString("macFUSE.incompatibleTitle"),
            system.localizedString("macFUSE.incompatibleMessage")
                .replace("{installed}", installed).replace(/\{required\}/g, required));
    }
    if (!system.files.fileExistsAtPath(path + "/Contents/Resources/mount_macfuse") ||
        !system.files.fileExistsAtPath(path + "/Contents/Frameworks/MFMount.framework/Versions/A/MFMount") ||
        !system.files.fileExistsAtPath("/usr/local/lib/libfuse.2.dylib")) {
        return installationError(system.localizedString("macFUSE.incompleteTitle"),
            system.localizedString("macFUSE.incompleteMessage").replace("{required}", required));
    }
    return true;
}

function checkDriverUsage() {
    if (!system.files.fileExistsAtPath("/Library/Application Support/ezNTFS/Driver/installed.plist") &&
        !system.files.fileExistsAtPath("/Library/Application Support/ezNTFS/service.plist")) {
        return true;
    }

    var media = system.ioregistry.matchingClass("IOMedia") || [];
    var inUse = Array.prototype.some.call(media, function (entry) {
        // A partition scheme can hold the whole disk open with no volumes in use.
        return entry["BSD Name"] && entry["Open"] &&
            (!entry["Whole"] || entry["Leaf"]) && isExternal(entry);
    });
    if (!inUse) {
        return true;
    }

    return installationError(system.localizedString("externalDisks.title"),
        system.localizedString("externalDisks.message"));
}
  ]]></script>
  <choices-outline>
    <line choice="ezntfs"/>
    @REINSTALL_LINE@
  </choices-outline>
  <choice id="ezntfs" title="ezNTFS" visible="false">
    <pkg-ref id="@IDENTIFIER@"/>
  </choice>
  <pkg-ref id="@IDENTIFIER@" version="@VERSION@">@COMPONENT@</pkg-ref>
  @REINSTALL_CHOICE@
</installer-gui-script>
